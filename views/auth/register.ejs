<!DOCTYPE html>
<html lang="en">
<%- include('../layouts/head', { title: 'Create an account — Scatch', pageCss: ['auth'] }) %>
<body>
<%- include('../layouts/navbar') %>

<section class="auth-wrap">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <div class="auth-card row g-0 fade-up">

                    <div class="col-lg-5 d-none d-lg-flex">
                        <div class="auth-side">
                            <p class="eyebrow mb-3">Join Scatch</p>
                            <h2>Your style,<br>your story.</h2>
                            <p class="mt-3">Create an account to track orders, save your cart across
                                devices, and get early access to new drops.</p>
                        </div>
                    </div>

                    <div class="col-lg-7">
                        <div class="auth-form">
                            <h3 class="mb-1">Create your account</h3>
                            <p class="text-muted mb-4">It only takes a minute.</p>

                            <div id="registerAlert" class="alert d-none" role="alert"></div>

                            <form id="registerForm" novalidate>
                                <div class="mb-3">
                                    <label class="form-label">Full name</label>
                                    <input type="text" class="form-control" id="fullname" name="fullname" required minlength="3" placeholder="Jane Doe">
                                    <div class="invalid-feedback">Please enter your full name (min 3 characters).</div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Email address</label>
                                    <input type="email" class="form-control" id="email" name="email" required placeholder="you@example.com">
                                    <div class="invalid-feedback">Please enter a valid email address.</div>
                                </div>

                                <div class="mb-1">
                                    <label class="form-label">Password</label>
                                    <div class="password-field">
                                        <input type="password" class="form-control" id="password" name="password" required minlength="6" placeholder="Create a password">
                                        <button type="button" class="password-toggle" data-target="password" aria-label="Show password">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                    <div class="invalid-feedback d-block" id="passwordError" style="display:none !important;">Password must be at least 6 characters.</div>
                                </div>
                                <div class="password-strength"><div class="password-strength-bar" id="strengthBar"></div></div>
                                <span class="password-strength-label" id="strengthLabel">Password strength</span>

                                <div class="mb-3 mt-3">
                                    <label class="form-label">Confirm password</label>
                                    <div class="password-field">
                                        <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required placeholder="Re-enter your password">
                                        <button type="button" class="password-toggle" data-target="confirmPassword" aria-label="Show password">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                    <div class="invalid-feedback" id="confirmError">Passwords do not match.</div>
                                </div>

                                <div class="form-check mb-4">
                                    <input class="form-check-input" type="checkbox" id="terms" required>
                                    <label class="form-check-label small" for="terms">
                                        I agree to the Terms of Service and Privacy Policy
                                    </label>
                                </div>

                                <button type="submit" class="btn btn-gold w-100 py-2" id="registerBtn">
                                    Create account
                                </button>

                                <div class="auth-divider">or</div>

                                <p class="text-center small mb-0">
                                    Already have an account? <a href="/login" class="fw-semibold text-dark">Sign in</a>
                                </p>
                            </form>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

<%- include('../layouts/footer') %>
<script src="/javascript/auth.js"></script>
</body>
</html>
