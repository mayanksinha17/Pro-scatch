<!DOCTYPE html>
<html lang="en">
<%- include('../layouts/head', { title: 'Admin Dashboard — Scatch', pageCss: ['dashboard'] }) %>
<body>
<%- include('../layouts/navbar') %>

<div class="admin-shell">
    <aside class="admin-sidebar">
        <div class="brand"><i class="bi bi-speedometer2"></i> Admin</div>
        <nav class="nav flex-column">
            <button class="nav-link active text-start" data-pane="overview"><i class="bi bi-grid me-2"></i>Overview</button>
            <button class="nav-link text-start" data-pane="products"><i class="bi bi-box-seam me-2"></i>Products</button>
            <button class="nav-link text-start" data-pane="orders"><i class="bi bi-receipt me-2"></i>Orders</button>
            <button class="nav-link text-start" data-pane="customers"><i class="bi bi-people me-2"></i>Customers</button>
        </nav>
    </aside>

    <main class="admin-main">
        <div id="adminAlert" class="alert d-none"></div>

        <!-- Overview -->
        <div class="admin-pane" data-pane="overview">
            <h3 class="mb-4">Overview</h3>
            <div class="row g-3 mb-4">
                <div class="col-6 col-lg-3">
                    <div class="stat-card">
                        <div class="stat-icon mb-3"><i class="bi bi-box-seam"></i></div>
                        <div class="stat-value" id="statProducts">—</div>
                        <div class="stat-label">Products</div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="stat-card">
                        <div class="stat-icon mb-3"><i class="bi bi-people"></i></div>
                        <div class="stat-value" id="statCustomers">—</div>
                        <div class="stat-label">Customers</div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="stat-card">
                        <div class="stat-icon mb-3"><i class="bi bi-receipt"></i></div>
                        <div class="stat-value" id="statOrders">—</div>
                        <div class="stat-label">Orders</div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="stat-card">
                        <div class="stat-icon mb-3"><i class="bi bi-cash-stack"></i></div>
                        <div class="stat-value" id="statRevenue">—</div>
                        <div class="stat-label">Revenue</div>
                    </div>
                </div>
            </div>
            <p class="text-muted small"><i class="bi bi-info-circle"></i> Analytics chart omitted — there's
                no time-series sales data in the current schema to plot honestly.</p>
        </div>

        <!-- Products -->
        <div class="admin-pane d-none" data-pane="products">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="mb-0">Products</h3>
                <button class="btn btn-gold btn-sm" data-bs-toggle="modal" data-bs-target="#productModal" id="newProductBtn">
                    <i class="bi bi-plus-lg"></i> Add product
                </button>
            </div>
            <div class="admin-table">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr><th>Image</th><th>Name</th><th>Price</th><th>Discount</th><th>Actions</th></tr>
                    </thead>
                    <tbody id="productsTableBody"></tbody>
                </table>
            </div>
        </div>

        <!-- Orders -->
        <div class="admin-pane d-none" data-pane="orders">
            <h3 class="mb-3">Orders</h3>
            <div class="admin-table">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Customer</th><th>Items</th><th>Total</th><th>Status</th><th>Date</th></tr></thead>
                    <tbody id="ordersTableBody"></tbody>
                </table>
            </div>
        </div>

        <!-- Customers -->
        <div class="admin-pane d-none" data-pane="customers">
            <h3 class="mb-3">Customers</h3>
            <p class="text-muted small"><i class="bi bi-info-circle"></i> There's no "list all ushers" API
                yet (only per-user profile lookups), so this view isn't wired to real data. Adding a
                protected <code>GET /ushers</code> admin-list endpoint would enable it.</p>
        </div>
    </main>
</div>

<!-- Add/Edit product modal -->
<div class="modal fade" id="productModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="productModalTitle">Add product</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="productForm">
                    <input type="hidden" id="productId">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" class="form-control" id="pName" required>
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label">Price (₹)</label>
                            <input type="number" class="form-control" id="pPrice" required min="0">
                        </div>
                        <div class="col-6">
                            <label class="form-label">Discount (%)</label>
                            <input type="number" class="form-control" id="pDiscount" min="0" max="100" value="0">
                        </div>
                    </div>
                    <div class="mb-3 mt-2">
                        <label class="form-label">Image URL</label>
                        <input type="url" class="form-control" id="pImage" placeholder="https://…">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-ink" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-gold" id="saveProductBtn">Save product</button>
            </div>
        </div>
    </div>
</div>

<%- include('../layouts/footer') %>
<script src="/javascript/dashboard.js"></script>
</body>
</html>
