<!DOCTYPE html>
<html lang="en">
<%- include('../layouts/head', { title: 'Something went wrong — Scatch', pageCss: [] }) %>
<body>
<%- include('../layouts/navbar') %>

<section class="container text-center" style="padding: 6rem 0;">
    <p class="eyebrow justify-content-center mb-3">Error 500</p>
    <h1 style="font-size: clamp(3rem, 8vw, 6rem);">Something snagged.</h1>
    <p class="text-muted mb-4" style="max-width:460px; margin:0 auto;">
        An unexpected error happened on our end. Try again in a moment.
    </p>
    <% if (typeof error !== 'undefined' && error && process.env.NODE_ENV === 'development') { %>
        <pre class="text-start bg-light p-3 rounded small mx-auto" style="max-width:600px; overflow:auto;"><%= error.message %></pre>
    <% } %>
    <a href="/" class="btn btn-gold btn-lg">Back to home</a>
</section>

<%- include('../layouts/footer') %>
</body>
</html>
