<!DOCTYPE html>
<html lang="en">
<%- include('layouts/head', { title: 'Scatch — Premium Fashion & Lifestyle', pageCss: [] }) %>
<body>
<%- include('layouts/navbar') %>

<!-- ============ HERO ============ -->
<section class="hero">
    <div class="ribbon"></div>
    <div class="container position-relative">
        <div class="row align-items-center">
            <div class="col-lg-7 fade-up">
                <p class="eyebrow">New Season Arrivals</p>
                <h1 class="mb-3">Style that feels<br>like it was made for you.</h1>
                <p class="lead mb-4">
                    Curated fashion and lifestyle pieces, handpicked for quality
                    and character. Discover the collection.
                </p>
                <div class="d-flex gap-3">
                    <a href="/shop" class="btn btn-gold btn-lg">Shop the collection</a>
                    <a href="#featured" class="btn btn-outline-light btn-lg">See what's new</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============ CATEGORIES ============ -->
<section class="container mt-5 pt-3">
    <div class="section-title">
        <h2>Shop by category</h2>
        <div class="rule"></div>
    </div>
    <div class="row g-3">
        <div class="col-6 col-md-3">
            <a href="/shop?category=footwear" class="cat-card" style="background-image:url('https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=500')">
                <span>Footwear</span>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="/shop?category=apparel" class="cat-card" style="background-image:url('https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=500')">
                <span>Apparel</span>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="/shop?category=accessories" class="cat-card" style="background-image:url('https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500')">
                <span>Accessories</span>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="/shop?category=bags" class="cat-card" style="background-image:url('https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=500')">
                <span>Bags</span>
            </a>
        </div>
    </div>
</section>

<!-- ============ FEATURED / LATEST PRODUCTS ============ -->
<section class="container mt-5 pt-3" id="featured">
    <div class="section-title">
        <h2>Latest products</h2>
        <div class="rule"></div>
        <a href="/shop" class="text-decoration-none fw-semibold small">View all <i class="bi bi-arrow-right"></i></a>
    </div>

    <div class="row g-4">
        <% if (products && products.length > 0) { %>
            <% products.forEach(function(product, i) { %>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="product-card fade-up delay-<%= (i % 3) + 1 %>">
                        <a href="/product/<%= product._id %>" class="thumb-wrap d-block">
                            <% if (product.discount && product.discount > 0) { %>
                                <span class="badge-tag"><%= product.discount %>% OFF</span>
                            <% } %>
                            <img src="<%= product.image || 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500' %>" alt="<%= product.name %>">
                        </a>
                        <div class="card-body">
                            <h5><a href="/product/<%= product._id %>" class="text-decoration-none text-dark"><%= product.name %></a></h5>
                            <div class="price">
                                ₹<%= (product.price - (product.price * (product.discount||0) / 100)).toFixed(0) %>
                                <% if (product.discount && product.discount > 0) { %>
                                    <span class="old">₹<%= product.price %></span>
                                <% } %>
                            </div>
                            <button class="btn btn-ink w-100 mt-2 btn-sm add-to-cart-btn"
                                    data-id="<%= product._id %>"
                                    data-name="<%= product.name %>"
                                    data-price="<%= product.price %>"
                                    data-discount="<%= product.discount || 0 %>"
                                    data-image="<%= product.image || '' %>">
                                Add to cart
                            </button>
                        </div>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div class="empty-state">
                <i class="bi bi-bag-x"></i>
                <p class="mt-3">No products yet — check back soon.</p>
            </div>
        <% } %>
    </div>
</section>

<!-- ============ NEWSLETTER ============ -->
<section class="container my-5 py-3">
    <div class="newsletter-section p-5 text-center">
        <h3 class="mb-2">Join the list</h3>
        <p class="text-secondary mb-4">Get early access to drops, style edits, and member-only offers.</p>
        <form class="d-flex gap-2 justify-content-center flex-column flex-sm-row mx-auto" style="max-width:420px" onsubmit="return false;">
            <input type="email" class="form-control" placeholder="you@example.com" required>
            <button class="btn btn-gold" type="submit">Subscribe</button>
        </form>
    </div>
</section>

<%- include('layouts/footer') %>
</body>
</html>
