<!DOCTYPE html>
<html lang="en">
<%- include('../layouts/head', { title: 'My Profile — Scatch', pageCss: ['profile'] }) %>
<body>
<%- include('../layouts/navbar') %>

<section class="container my-5">
    <div class="row g-4">

        <div class="col-lg-3">
            <div class="profile-card mb-3">
                <img src="https://api.dicebear.com/7.x/initials/svg?seed=U" class="profile-avatar" id="profileAvatar" alt="Avatar">
                <h5 class="mb-0" id="profileName">…</h5>
                <p class="small mb-0" style="color:rgba(255,255,255,.7)" id="profileEmail">…</p>
            </div>

            <div class="nav flex-column profile-nav">
                <button class="nav-link active text-start" data-pane="overview"><i class="bi bi-person me-2"></i>Overview</button>
                <button class="nav-link text-start" data-pane="orders"><i class="bi bi-bag-check me-2"></i>Order history</button>
                <button class="nav-link text-start" data-pane="edit"><i class="bi bi-pencil me-2"></i>Edit profile</button>
                <a class="nav-link text-start text-danger" href="/logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a>
            </div>
        </div>

        <div class="col-lg-9">
            <div id="profileAlert" class="alert d-none"></div>

            <!-- Overview -->
            <div class="profile-pane" data-pane="overview">
                <h4 class="mb-3">Account overview</h4>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="order-row"><strong>Full name</strong><div id="ovName" class="text-muted">—</div></div>
                    </div>
                    <div class="col-md-6">
                        <div class="order-row"><strong>Email</strong><div id="ovEmail" class="text-muted">—</div></div>
                    </div>
                    <div class="col-md-6">
                        <div class="order-row"><strong>Phone</strong><div id="ovContact" class="text-muted">—</div></div>
                    </div>
                    <div class="col-md-6">
                        <div class="order-row"><strong>Total orders</strong><div id="ovOrderCount" class="text-muted">—</div></div>
                    </div>
                </div>
            </div>

            <!-- Orders -->
            <div class="profile-pane d-none" data-pane="orders">
                <h4 class="mb-3">Order history</h4>
                <div id="ordersList"></div>
            </div>

            <!-- Edit -->
            <div class="profile-pane d-none" data-pane="edit">
                <h4 class="mb-3">Edit profile</h4>
                <form id="editProfileForm" style="max-width:480px;">
                    <div class="mb-3">
                        <label class="form-label">Full name</label>
                        <input type="text" class="form-control" id="editFullname" required minlength="3">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Phone number</label>
                        <input type="text" class="form-control" id="editContact">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Profile picture URL</label>
                        <input type="url" class="form-control" id="editPicture" placeholder="https://…">
                    </div>
                    <button type="submit" class="btn btn-gold">Save changes</button>
                </form>
            </div>
        </div>

    </div>
</section>

<%- include('../layouts/footer') %>
<script src="/javascript/profile.js"></script>
</body>
</html>
