<!DOCTYPE html>
<html lang="en">
<%- include('../layouts/head', { title: 'Shop — Scatch', pageCss: ['shop'] }) %>
<body>
<%- include('../layouts/navbar') %>

<section class="shop-header">
    <div class="container">
        <p class="eyebrow mb-2">All products</p>
        <h1>Shop the collection</h1>
        <p class="mb-0">Browse everything currently in stock.</p>
    </div>
</section>

<section class="container my-4">
    <div class="row g-4">

        <!-- Filters -->
        <div class="col-lg-3">
            <div class="filter-panel">
                <h6>Search</h6>
                <div class="search-wrap mb-3">
                    <i class="bi bi-search"></i>
                    <input type="text" id="searchInput" class="form-control" placeholder="Search products…">
                </div>

                <hr>

                <h6>Price range</h6>
                <input type="range" class="form-range" id="priceRange" min="0" max="10000" step="100" value="10000">
                <div class="price-range-values">
                    <span>₹0</span>
                    <span id="priceRangeValue">₹10,000</span>
                </div>

                <hr>

                <h6>Sort by</h6>
                <select class="form-select" id="sortSelect">
                    <option value="newest">Newest first</option>
                    <option value="price-asc">Price: Low to High</option>
                    <option value="price-desc">Price: High to Low</option>
                    <option value="name-asc">Name: A–Z</option>
                </select>

                <hr>

                <button class="btn btn-outline-ink btn-sm w-100" id="resetFilters">Reset filters</button>
            </div>
        </div>

        <!-- Product grid -->
        <div class="col-lg-9">
            <div class="shop-toolbar d-flex justify-content-between align-items-center mb-4">
                <span class="small text-muted" id="resultCount">Loading products…</span>
            </div>

            <div class="row g-4" id="productGrid">
                <!-- populated by shop.js -->
                <div class="col-6 col-md-4"><div class="skeleton"></div></div>
                <div class="col-6 col-md-4"><div class="skeleton"></div></div>
                <div class="col-6 col-md-4"><div class="skeleton"></div></div>
            </div>

            <nav class="mt-5" id="paginationWrap">
                <ul class="pagination justify-content-center" id="pagination"></ul>
            </nav>
        </div>

    </div>
</section>

<%- include('../layouts/footer') %>
<script src="/javascript/shop.js"></script>
</body>
</html>
