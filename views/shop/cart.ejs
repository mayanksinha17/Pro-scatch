<!DOCTYPE html>
<html lang="en">
<%- include('../layouts/head', { title: 'Your Cart — Scatch', pageCss: ['cart'] }) %>
<body>
<%- include('../layouts/navbar') %>

<section class="container my-5">
    <h1 class="mb-4">Your cart</h1>

    <div class="row g-4">
        <div class="col-lg-8">
            <div id="cartItemsWrap">
                <!-- populated by cart.js -->
            </div>
        </div>

        <div class="col-lg-4">
            <div class="cart-summary">
                <h5 class="mb-3">Order summary</h5>
                <div class="summary-row"><span>Subtotal</span><span id="sumSubtotal">₹0</span></div>
                <div class="summary-row"><span>Shipping</span><span id="sumShipping">₹0</span></div>
                <div class="summary-row"><span>Tax (5%)</span><span id="sumTax">₹0</span></div>
                <div class="summary-row total"><span>Total</span><span id="sumTotal">₹0</span></div>

                <a href="/checkout" class="btn btn-gold w-100 mt-3" id="checkoutBtn">
                    Proceed to checkout <i class="bi bi-arrow-right"></i>
                </a>
                <a href="/shop" class="btn btn-outline-ink w-100 mt-2">Continue shopping</a>
            </div>
        </div>
    </div>
</section>

<%- include('../layouts/footer') %>
<script src="/javascript/cart.js"></script>
</body>
</html>
